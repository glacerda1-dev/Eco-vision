DATABASE_URL=sqlite://data/eco_vision.db
BIND_ADDR=127.0.0.1:8080
DEMO_CITY="Rio de Janeiro/RJ"
CITY_LAT=-22.9068
CITY_LON=-43.1729

# Opcional: endpoint compatível com a API Chat Completions.
# A aplicação envia somente códigos fixos de remediação; nunca envia relatos.
# LLM_API_URL=
# LLM_API_KEY=
# LLM_MODEL=

# Use uma senha exclusiva com pelo menos 12 caracteres.
# ECO_VISION_ADMIN_EMAIL=admin@exemplo.com
# ECO_VISION_ADMIN_PASSWORD=
# Chave aleatória de 32 bytes em hexadecimal para cifrar segredos TOTP no banco.
# Gere com: openssl rand -hex 32
# ECO_VISION_MFA_ENCRYPTION_KEY=
# Será ativado em caso de implantação HTTPS;
ECO_VISION_COOKIE_SECURE=false

# Nível de logs estruturados do tracing (opcional; padrão: info,eco_vision=debug,tower_http=debug)
# RUST_LOG=info,eco_vision=debug,tower_http=debug
